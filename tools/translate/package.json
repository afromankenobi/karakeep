{
  "name": "@karakeep/translate",
  "version": "0.1.0",
  "description": "AI-powered translation tool for Karakeep i18n files",
  "bin": {
    "translate": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "run": "tsx --env-file=./.env src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@karakeep/shared": "workspace:^",
    "chalk": "^5.3.0",
    "openai": "^4.86.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.8.1",
    "typescript": "^5.9"
  }
}
